{
  "name": "product",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:generate": "pnpm --filter @product/api openapi:generate",
    "openapi:check": "pnpm --filter @product/api openapi:check",
    "db:generate": "pnpm --filter @product/db generate",
    "db:migrate": "pnpm --filter @product/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @product/db migrate:deploy",
    "db:seed": "pnpm --filter @product/db seed",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  },
  "pnpm": {
    "overrides": {
      "@better-auth/utils": "0.4.2"
    }
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
