EXPO_PUBLIC_API_URL=http://localhost:3000
RCT_METRO_PORT=
# QuickPose client SDK key from https://dev.quickpose.ai
# Register it for iOS com.healthyapp.app and Android com.beatset.app.
EXPO_PUBLIC_QUICKPOSE_SDK_KEY=
# Path to Firebase google-services.json for Android push. On EAS, create a
# `file` variable named GOOGLE_SERVICES_JSON instead. Never commit the file.
GOOGLE_SERVICES_JSON=
# Maps SDK for Android (react-native-maps tiles in release APKs). Not Firebase.
# On EAS, set as a secret on the production environment. Restrict the key to
# package com.beatset.app + the production keystore SHA-1.
GOOGLE_MAPS_API_KEY=
# Optional: disposable IDs for a friend-account build. Leave unset for the store
# ids (iOS com.healthyapp.app, Android com.beatset.app).
# IOS_BUNDLE_IDENTIFIER=com.healthyapp.tfpreview
# ANDROID_PACKAGE=com.healthyapp.tfpreview

EXPO_PUBLIC_API_URL=http://192.168.0.195:3000
RCT_METRO_PORT=8765
EXPO_PUBLIC_QUICKPOSE_SDK_KEY=
# API origin for the website invite page. Not the marketing site (https://beatset.tech).
# PUBLIC_API_BASE_URL=https://api.example.com

