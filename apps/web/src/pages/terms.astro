---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms"
  description="Terms of use for the Product website and early access waitlist."
>
  <article class="legal">
    <h1>Terms of Service</h1>
    <p class="updated">Last updated: August 27, 2026</p>

    <p>
      These terms govern your use of the Product marketing website and waitlist. This is a placeholder
      agreement for early access and will be updated before launch.
    </p>

    <h2>Acceptance</h2>
    <p>
      By using this site or submitting your email to the waitlist, you agree to these terms and our
      <a href="/privacy">Privacy Policy</a>.
    </p>

    <h2>Waitlist</h2>
    <p>
      Joining the waitlist does not guarantee access, pricing, or availability. We may modify or
      discontinue early access at any time.
    </p>

    <h2>Contact</h2>
    <p>
      Questions about these terms can be sent to
      <a href="mailto:legal@product.example">legal@product.example</a>.
    </p>
  </article>
</BaseLayout>

<style>
  .legal {
    max-width: 40rem;
  }

  h1 {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.75rem);
    letter-spacing: -0.02em;
  }

  .updated {
    margin: 0 0 var(--space-lg);
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  h2 {
    margin: var(--space-xl) 0 var(--space-sm);
    font-size: 1.25rem;
  }

  p {
    margin: 0 0 var(--space-md);
    color: var(--color-muted);
  }
</style>
