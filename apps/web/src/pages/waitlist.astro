---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Waitlist"
  description="Join the Healthy waitlist. We will tell you when the app is ready."
>
  <section class="waitlist-page">
    <p class="eyebrow">Early access</p>
    <h1>Save your spot</h1>
    <p class="lede">
      Leave your email. We will write when Healthy is ready. No spam. Just a note when you can
      download the app.
    </p>
  </section>
</BaseLayout>
