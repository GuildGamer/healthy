---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
---

<BaseLayout
  title="Healthy"
  description="Small wins, everyday. Stay healthy and challenge your friends to stay healthy."
>
  <div class="home-showcase">
    <div class="home-showcase-media" aria-hidden="true">
      <video
        class="home-showcase-video"
        src="/hero-pushups.mov"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
      ></video>
      <div class="home-showcase-overlay"></div>
    </div>

    <div class="home-showcase-inner">
      <div class="hero-copy">
        <h1>Small wins, everyday</h1>
        <p class="lede">Stay healthy and challenge your friends to stay healthy</p>
        <a class="button" href="/waitlist" data-waitlist-open>Join the waitlist</a>
      </div>
    </div>
  </div>
</BaseLayout>
