---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Product"
  description="Product — a focused app for getting things done. Join the waitlist and download when we launch."
>
  <section class="hero">
    <p class="eyebrow">Coming soon</p>
    <h1>Product</h1>
    <p class="lede">
      A calm, focused experience built for clarity. Join early access and be first when the apps drop.
    </p>
    <div class="cta-row">
      <a class="button button-primary" href="/waitlist">Join the waitlist</a>
      <a class="button button-ghost" href="#download">Get the app</a>
    </div>
  </section>

  <section id="download" class="download" aria-labelledby="download-heading">
    <h2 id="download-heading">Download</h2>
    <p class="section-copy">App store listings go live at launch. Placeholders for now.</p>
    <div class="store-row">
      <a class="store-link" href="#" aria-disabled="true" tabindex="-1">App Store — coming soon</a>
      <a class="store-link" href="#" aria-disabled="true" tabindex="-1">Google Play — coming soon</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-xl) 0;
  }

  .eyebrow {
    margin: 0 0 var(--space-sm);
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .lede {
    margin: 0 0 var(--space-lg);
    max-width: 36rem;
    color: var(--color-muted);
    font-size: 1.125rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.25rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .button-primary {
    background: var(--color-accent);
    color: var(--color-background);
  }

  .button-primary:hover {
    filter: brightness(1.05);
    text-decoration: none;
  }

  .button-ghost {
    border: 1px solid color-mix(in srgb, var(--color-muted) 40%, transparent);
    color: var(--color-text);
    background: transparent;
  }

  .button-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }

  .download {
    margin-top: calc(var(--space-xl) * 1.5);
    padding-top: var(--space-xl);
    border-top: 1px solid color-mix(in srgb, var(--color-muted) 25%, transparent);
  }

  .download h2 {
    margin: 0 0 var(--space-sm);
    font-family: var(--font-display);
    font-size: 1.75rem;
  }

  .section-copy {
    margin: 0 0 var(--space-lg);
    color: var(--color-muted);
  }

  .store-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .store-link {
    display: inline-flex;
    padding: var(--space-md) var(--space-lg);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-muted);
    border: 1px solid color-mix(in srgb, var(--color-muted) 20%, transparent);
    pointer-events: none;
    text-decoration: none;
  }
</style>
