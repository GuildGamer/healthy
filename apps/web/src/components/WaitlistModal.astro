---
const apiUrl = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:3000';
const startOpen = Astro.url.pathname.replace(/\/$/, '') === '/waitlist';
---

<dialog
  id="waitlist-dialog"
  class="waitlist-dialog"
  aria-labelledby="waitlist-title"
  open={startOpen}
>
  <button type="button" class="waitlist-close" data-waitlist-close aria-label="Close">
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path
        fill="currentColor"
        d="M18.3 5.71a1 1 0 0 0-1.41 0L12 10.59 7.11 5.7A1 1 0 0 0 5.7 7.11L10.59 12 5.7 16.89a1 1 0 1 0 1.41 1.41L12 13.41l4.89 4.89a1 1 0 0 0 1.41-1.41L13.41 12l4.89-4.89a1 1 0 0 0 0-1.4Z"
      ></path>
    </svg>
  </button>

  <div id="waitlist-intro">
    <h2 id="waitlist-title">Save your spot</h2>
    <p class="lede">Get notified when Healthy launches.</p>
  </div>

  <form id="waitlist-form" class="form" novalidate>
    <label class="sr-only" for="waitlist-email">Email</label>
    <div class="row">
      <input
        id="waitlist-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder="hey@gethealthyapp.com"
      />
      <button type="submit">Join the waitlist</button>
    </div>
    <p id="waitlist-error" class="error" hidden></p>
  </form>

  <div id="waitlist-thanks" class="thank-you" hidden>
    <h2>You are on the list</h2>
    <p>Thanks. We will be in touch at <strong id="waitlist-submitted-email"></strong>.</p>
    <button type="button" class="waitlist-done" data-waitlist-close>Done</button>
  </div>
</dialog>

<script is:inline define:vars={{ apiUrl }}>
  (function waitlistModal() {
    const dialog = document.getElementById('waitlist-dialog');
    if (!(dialog instanceof HTMLDialogElement)) return;

    const form = document.getElementById('waitlist-form');
    const intro = document.getElementById('waitlist-intro');
    const thankYou = document.getElementById('waitlist-thanks');
    const errorEl = document.getElementById('waitlist-error');
    const submittedEmail = document.getElementById('waitlist-submitted-email');
    const emailInput = document.getElementById('waitlist-email');

    function showError(message) {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function clearError() {
      if (!errorEl) return;
      errorEl.textContent = '';
      errorEl.hidden = true;
    }

    function isValidEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());
    }

    function shouldStartOpen() {
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      return path === '/waitlist' || window.location.hash === '#waitlist';
    }

    function setWaitlistHash(open) {
      const url = new URL(window.location.href);
      if (url.pathname.replace(/\/$/, '') === '/waitlist') return;

      if (open) {
        if (url.hash !== '#waitlist') {
          url.hash = 'waitlist';
          window.history.replaceState(null, '', url.href);
        }
        return;
      }

      if (url.hash === '#waitlist') {
        window.history.replaceState(null, '', `${url.pathname}${url.search}`);
      }
    }

    function openWaitlist(event) {
      event?.preventDefault();
      if (dialog.open && dialog.matches(':modal')) return;
      if (dialog.open) {
        dialog.close();
      }
      dialog.showModal();
      setWaitlistHash(true);
      if (emailInput instanceof HTMLInputElement && !thankYou?.hidden) {
        return;
      }
      if (emailInput instanceof HTMLInputElement) {
        emailInput.focus();
      }
    }

    function closeWaitlist() {
      setWaitlistHash(false);
      if (dialog.open) {
        dialog.close();
      }
    }

    document.querySelectorAll('[data-waitlist-open]').forEach((trigger) => {
      trigger.addEventListener('click', openWaitlist);
    });

    dialog.querySelectorAll('[data-waitlist-close]').forEach((trigger) => {
      trigger.addEventListener('click', closeWaitlist);
    });

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) {
        closeWaitlist();
      }
    });

    dialog.addEventListener('close', () => {
      setWaitlistHash(false);
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearError();

      const formData = new FormData(form);
      const email = String(formData.get('email') ?? '').trim();

      if (!isValidEmail(email)) {
        showError('Enter a valid email address.');
        return;
      }

      try {
        await fetch(`${apiUrl}/waitlist`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email }),
        });
      } catch {
        // API may be unavailable during static preview; still show thank-you.
      }

      if (submittedEmail) {
        submittedEmail.textContent = email;
      }
      form.hidden = true;
      if (intro) {
        intro.hidden = true;
      }
      if (thankYou) {
        thankYou.hidden = false;
      }
    });

    if (shouldStartOpen()) {
      openWaitlist();
    }
  })();
</script>

<style>
  .waitlist-dialog {
    position: relative;
    overflow: hidden;
    width: min(28rem, calc(100vw - 2rem));
    margin: auto;
    padding: 2.75rem var(--space-lg) var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface-raised);
    background-image:
      radial-gradient(
        ellipse 90% 80% at 0% 0%,
        rgba(11, 18, 32, 0.9) 0%,
        rgba(11, 18, 32, 0.4) 45%,
        transparent 75%
      ),
      linear-gradient(
        90deg,
        rgba(11, 18, 32, 1) 0%,
        rgba(11, 18, 32, 0.96) 25%,
        rgba(11, 18, 32, 0.86) 60%,
        rgba(11, 18, 32, 0.78) 100%
      ),
      linear-gradient(
        180deg,
        transparent 70%,
        rgba(11, 18, 32, 0.15) 100%
      );
    color: var(--color-text);
    box-shadow: 0 28px 64px color-mix(in srgb, #000 48%, transparent);
    animation: waitlist-in 220ms ease-out;
  }

  .waitlist-dialog::backdrop {
    background: color-mix(in srgb, #03060d 72%, transparent);
  }

  .waitlist-close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
  }

  .waitlist-close:hover {
    color: var(--color-text);
  }

  #waitlist-intro {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  h2 {
    margin: 0 0 0.5rem;
    font-family: var(--font-hero);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.1;
  }

  .lede {
    margin: 0;
    color: var(--color-muted);
    font-size: 1rem;
    line-height: 1.45;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  input {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    min-height: 3.25rem;
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
  }

  input::placeholder {
    color: var(--color-muted);
  }

  input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-color: transparent;
  }

  .form button[type='submit'],
  .waitlist-done {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.1875rem;
    padding: 1.25rem 2.5rem;
    border: none;
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 500;
    cursor: pointer;
  }

  .form button[type='submit'] {
    width: 100%;
  }

  .form button[type='submit']:hover,
  .waitlist-done:hover {
    background: var(--color-accent-pressed);
  }

  .error {
    margin: var(--space-sm) 0 0;
    color: var(--color-danger);
    font-size: 0.9rem;
    text-align: center;
  }

  .thank-you {
    text-align: center;
  }

  .thank-you h2 {
    margin: 0 0 0.5rem;
  }

  .thank-you p {
    margin: 0 0 var(--space-xl);
    color: var(--color-muted);
  }

  .thank-you strong {
    color: var(--color-text);
  }

  .waitlist-done {
    width: 100%;
  }

  @keyframes waitlist-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }

    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .waitlist-dialog {
      animation: none;
    }
  }
</style>
