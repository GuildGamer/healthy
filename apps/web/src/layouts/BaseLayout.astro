---
import LeafMark from '../components/LeafMark.astro';
import WaitlistModal from '../components/WaitlistModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Healthy',
  description = 'Staying healthy, made easy. Join the waitlist.',
} = Astro.props;

const pageTitle = title === 'Healthy' ? title : `${title} · Healthy`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/apple-touch-icon.png', Astro.site)} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <a class="brand-mark" href="/">
        <span class="brand-clip">
          <span class="brand-word">Healthy</span>
        </span>
        <span class="brand-leaf">
          <LeafMark size={20} />
        </span>
      </a>
      <nav class="nav" aria-label="Primary">
        <a href="/waitlist" data-waitlist-open>Waitlist</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </nav>
    </header>

    <main class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>© {new Date().getFullYear()} Healthy</p>
      <nav aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/waitlist" data-waitlist-open>Waitlist</a>
      </nav>
    </footer>

    <WaitlistModal />
  </body>
</html>
