DATABASE_URL=postgresql://product:product@localhost:5433/product?schema=public
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-change-me-before-production
NODE_ENV=development
REMINDER_SCHEDULER_MODE=
REMINDER_DISPATCH_SECRET=
EXPO_ACCESS_TOKEN=
SMTP_HOST=0
SMTP_PORT=0
SMTP_USER=0
SMTP_PASS=0
SMTP_FROM=0
# Gym selfie checks use OpenAI vision (gpt-4o-mini by default).
# Leave as 0 locally to accept every photo. Set a real key to reject home shots.
EVIDENCE_VISION_API_KEY=0
EVIDENCE_VISION_MODEL=0
ADMIN_APP_URL=http://localhost:3001
# Origin group-challenge invite links are built against. Defaults to the public
# site, since an invite is opened on someone else's phone.
WEBSITE_URL=https://gethealthyapp.com
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:3000
# Google OAuth (Better Auth social). Empty until credentials are supplied.
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# App Store Server API / Notifications V2. Leave APPLE_ENVIRONMENT blank to
# disable Apple IAP so the API can boot without App Store Connect.
# sandbox | production
APPLE_ENVIRONMENT=
APPLE_BUNDLE_ID=com.healthyapp.app
# Numeric App Apple ID from App Store Connect. Required in production.
APPLE_APP_APPLE_ID=
