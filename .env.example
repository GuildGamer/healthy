DATABASE_URL=postgresql://product:product@localhost:5433/product?schema=public
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-change-me-before-production
NODE_ENV=development
# Testing grant: every account is a member. Set to 0 before launch, then
# delete the testing-membership call sites.
MEMBERSHIP_BYPASS=1
REMINDER_SCHEDULER_MODE=
REMINDER_DISPATCH_SECRET=
EXPO_ACCESS_TOKEN=
# Mailbox. Leave blank to use SendByte when SEND_BYTE_LIVE_KEY is set,
# otherwise SMTP when SMTP_* is complete, otherwise the local log mailer.
# log | smtp | sendbyte
# Switch this to change provider. Zepto Mail can be added as another value later.
EMAIL_PROVIDER=sendbyte
SEND_BYTE_LIVE_KEY=
# Visible From address for SendByte. Defaults to hello@gethealthyapp.com.
MAIL_FROM=hello@gethealthyapp.com
# Used when EMAIL_PROVIDER=smtp. 0 / blank keeps the local log mailer.
SMTP_HOST=0
SMTP_PORT=0
SMTP_USER=0
SMTP_PASS=0
SMTP_FROM=0
# Gym photo checks. 0 / blank accepts every photo locally.
# Provider: openai | gemini | openai-compatible. A real key with no provider uses OpenAI.
# Defaults: openai gpt-4o-mini, gemini gemini-2.5-flash.
# openai-compatible also needs EVIDENCE_VISION_BASE_URL and EVIDENCE_VISION_MODEL
# (Groq: https://api.groq.com/openai/v1).
EVIDENCE_VISION_PROVIDER=0
EVIDENCE_VISION_API_KEY=0
EVIDENCE_VISION_MODEL=0
EVIDENCE_VISION_BASE_URL=0
ADMIN_APP_URL=http://localhost:3001
# Origin group-challenge invite links are built against. Must be the host that
# serves /.well-known with HTTP 200 and no redirect — the apex 308s to www,
# which stops iOS and Android opening the app. Localhost cannot be a
# universal link; leave this on the public site unless you are only previewing
# the web invite page.
WEBSITE_URL=https://www.gethealthyapp.com
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
NEXT_PUBLIC_ADMIN_ORIGIN=http://localhost:3001
API_BASE_URL=http://localhost:3000
# Google OAuth (Better Auth social). Empty until credentials are supplied.
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# App Store Server API / Notifications V2. Leave APPLE_ENVIRONMENT blank to
# disable Apple IAP so the API can boot without App Store Connect.
# sandbox | production
APPLE_ENVIRONMENT=
APPLE_BUNDLE_ID=com.healthyapp.app
# Numeric App Apple ID from App Store Connect. Required in production.
APPLE_APP_APPLE_ID=
