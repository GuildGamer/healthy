{
  "name": "@product/contract",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./country-code": {
      "types": "./dist/country-code.d.ts",
      "import": "./dist/country-code.js",
      "require": "./dist/country-code.cjs"
    },
    "./display-name": {
      "types": "./dist/display-name.d.ts",
      "import": "./dist/display-name.js",
      "require": "./dist/display-name.cjs"
    },
    "./challenge-title": {
      "types": "./dist/challenge-title.d.ts",
      "import": "./dist/challenge-title.js",
      "require": "./dist/challenge-title.cjs"
    },
    "./challenge-sort": {
      "types": "./dist/challenge-sort.d.ts",
      "import": "./dist/challenge-sort.js",
      "require": "./dist/challenge-sort.cjs"
    },
    "./challenge-capture": {
      "types": "./dist/challenge-capture.d.ts",
      "import": "./dist/challenge-capture.js",
      "require": "./dist/challenge-capture.cjs"
    },
    "./match-board": {
      "types": "./dist/match-board.d.ts",
      "import": "./dist/match-board.js",
      "require": "./dist/match-board.cjs"
    },
    "./account-deletion": {
      "types": "./dist/account-deletion.d.ts",
      "import": "./dist/account-deletion.js",
      "require": "./dist/account-deletion.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/country-code.ts src/display-name.ts src/challenge-title.ts src/challenge-sort.ts src/challenge-capture.ts src/match-board.ts src/account-deletion.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"lint: contract skipped\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@orpc/contract": "^1.15.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@product/tsconfig": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
